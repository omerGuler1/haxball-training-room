# Luxora Futsal 2v2 — manual mode, no bots, you control the game

HAXBALL_TOKEN=PASTE_NEW_TOKEN_HERE
ROOM_NAME=⚽ Luxora Futsal 2v2
ROOM_PUBLIC=false
ROOM_PASSWORD=changeme
ROOM_MAX_PLAYERS=10
ROOM_GEO_CODE=TR
ROOM_GEO_LAT=39.0
ROOM_GEO_LON=35.0
ROOM_NO_PLAYER=true
STADIUM_PATH=./Luxora Futsal • Training Bot.hbs

# Manual mode: no auto-team assignment, no match lifecycle, no bots
MATCH_MODE=manual

# No bots
BOT_COUNT=0

# Native admin grant — your nickname here. Anyone joining with this name gets the
# Haxball admin star (start/stop/move players). Insecure (nick can be spoofed) —
# good enough for a small private room.
ADMIN_NICKNAMES=bats

# Database (shared across rooms)
DB_PATH=./data/haxball.db

# Debug
BOT_DEBUG=false
LOG_LEVEL=info

# Puppeteer
PUPPETEER_HEADLESS=true
